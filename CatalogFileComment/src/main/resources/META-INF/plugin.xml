<idea-plugin>
    <id>com.annotation.catalogfilecomment</id>
    <name>Catalog File Comments</name>
    <version>1.0.0.6</version>
    <vendor email="3842166270@qq.com" url="https://www.qingxian.online">QingXian</vendor>

    <resource-bundle>messages.CatalogFileCommentsBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.java</depends>

    <description><![CDATA[
        <h1>Catalog File Comments</h1>
        <br/>
        <b>Sticky Notes for Your Code Directory &amp; an Enterprise Architecture Panorama</b>
        <br/><br/>

        <p>
            In large projects, filenames often fail to fully convey business logic.
            <b>Catalog File Comments</b> lets you add custom annotations directly after filenames in the Project View.
        </p>
        <br/>

        <h2>📸 Feature 1: Visual Comments</h2>
        <ul>
            <li>Display custom comments right after the file name in the Project View.</li>
            <li>Subtle gray italic style that blends naturally into the IDE.</li>
        </ul>

        <div style="margin-bottom: 20px;">
            <a href="https://github.com/CyanQX/CatalogFileComment/blob/main/rendering.png?raw=true">
                <img src="https://github.com/CyanQX/CatalogFileComment/blob/main/rendering.png?raw=true" alt="Visual Comments Demo" width="600" border="0" style="border: 1px solid #808080; padding: 2px;">
            </a>
            <br/>
            <code>Example: AuthServiceImpl.java // Business Layer - Auth Implementation</code>
        </div>

        <h2>🧠 Feature 2: Smart Analysis</h2>
        <ul>
            <li>Auto-generate comments based on PSI analysis (Controller, Service, etc.).</li>
            <li>Built-in cloud rules recognize 100+ enterprise architecture components.</li>
        </ul>

        <div style="margin-bottom: 20px;">
             <a href="https://github.com/CyanQX/CatalogFileComment/blob/main/use.png?raw=true">
                <img src="https://github.com/CyanQX/CatalogFileComment/blob/main/use.png?raw=true" alt="Add Comment Dialog Demo" width="600" border="0" style="border: 1px solid #808080; padding: 2px;">
            </a>
        </div>

        <br/>
        <hr/>

        <h3>✨ Key Features</h3>
        <ul>
            <li><b>Visual Directory Comments:</b> Native gray style comments in the Project View.</li>
            <li><b>Smart Analysis:</b> Cloud-rule based recognition for 100+ architecture components.</li>
            <li><b>Cloud &amp; Offline:</b> Prioritizes cloud rules and falls back to a local cache.</li>
            <li><b>Management Panel:</b> Batch manage all comments via the Tools menu.</li>
        </ul>

        <br/>
        <div style="border: 1px solid #ffc107; padding: 10px; margin-top: 10px;">
            <b>⚠️ About</b><br/>
            <span style="font-size: smaller;">
                This plugin is developed in the author's spare time. Constructive feedback is always welcome.<br/>
                <i>(Please be gentle with your feedback. Thank you! 🙏)</i>
            </span>
        </div>

        <br/>
        <p><i>Let every filename carry its mission. Happy Coding! 🎉</i></p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>Version 1.0.0</h3>
        <ul>
            <li>🎉 Initial release</li>
            <li>📸 Feature: Visual file comments</li>
            <li>🧠 Feature: Smart cloud-based analysis</li>
        </ul>
    ]]></change-notes>

    <extensions defaultExtensionNs="com.intellij">
        <projectViewNodeDecorator
                implementation="com.annotation.catalogfilecomment.projectView.FileCommentTreeDecorator"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.annotation.catalogfilecomment.config.FileCommentConfigurable"
                id="CatalogFileCommentConfigurable"
                key="configurable.display.name"/>

        <applicationService
                serviceImplementation="com.annotation.catalogfilecomment.config.FileCommentConfigService"/>

        <notificationGroup id="Catalog File Comments" displayType="BALLOON" bundle="messages.CatalogFileCommentsBundle"
                           key="notification.group.catalog.file.comments"/>
    </extensions>

    <actions>
        <action id="CatalogFileComment.AddComment"
                class="com.annotation.catalogfilecomment.action.AddCommentAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="CutCopyPasteGroup"/>
        </action>

        <action id="CatalogFileComment.RemoveComment"
                class="com.annotation.catalogfilecomment.action.RemoveCommentAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after"
                          relative-to-action="CatalogFileComment.AddComment"/>
        </action>

        <action id="CatalogFileComment.OpenManager"
                class="com.annotation.catalogfilecomment.action.OpenManagerAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>